# Copy to .env and fill in. Never commit .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yellowribbon

# Comma-separated. Only needed for Flutter web; ignored while DEBUG=True.
CORS_ALLOWED_ORIGINS=
# Full origins with scheme, e.g. https://yellowribbon.onrender.com
# Required for the Django admin login form once the site is on HTTPS.
CSRF_TRUSTED_ORIGINS=

# Media storage. Leave all three blank and uploads stay on the local
# filesystem, which is what you want for development. Set all three in a
# hosted environment — its disk is wiped on every deploy, and a proof of
# delivery is evidence, not a cache.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Force TLS to the database on or off. Left blank it is inferred:
# required whenever DEBUG=False or RENDER is set.
DATABASE_SSL_REQUIRE=

GOOGLE_MAPS_SERVER_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=5
GOOGLE_ROUTES_TRAVEL_MODE=TWO_WHEELER
# Test keys only: pk_test_... / sk_test_... / whsk_...
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_TIMEOUT_SECONDS=15
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=0
# Must be http(s) — PayMongo rejects custom app schemes. Leave blank to use
# this server's own /api/payments/return/ pages, derived from the request.
PAYMONGO_SUCCESS_REDIRECT_URL=
PAYMONGO_FAILED_REDIRECT_URL=
# Supply ONE of these. JSON wins if both are set.
# Hosted: paste the whole service-account object on a single line.
FIREBASE_CREDENTIALS_JSON=
# Local dev: path to the gitignored service-account file.
FIREBASE_CREDENTIALS_PATH=

DELIVERY_FEE=30.00
RIDER_EARNINGS_PER_DELIVERY=30.00
PENDING_PAYMENT_TIMEOUT_MINUTES=30
SERVICE_AREA_CENTER_LAT=7.0083
SERVICE_AREA_CENTER_LNG=125.0894
SERVICE_AREA_RADIUS_KM=8
